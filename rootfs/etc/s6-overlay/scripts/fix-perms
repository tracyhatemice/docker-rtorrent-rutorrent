#!/bin/sh

echo "Fixing perms..."
mkdir -p /config/rtorrent \
  /config/rutorrent \
  /data \
  /passwd \
  /etc/nginx/conf.d \
  /etc/rtorrent \
  /var/cache/nginx \
  /var/lib/nginx \
  /var/log/nginx \
  /var/run/nginx \
  /var/run/php-fpm \
  /var/run/rtorrent
chown rtorrent:rtorrent \
  /config \
  /config/rtorrent \
  /config/rutorrent \
  /data
chown -R rtorrent:rtorrent \
  /etc/rtorrent \
  /passwd \
  /tpls \
  /var/cache/nginx \
  /var/lib/nginx \
  /var/log/nginx \
  /var/log/php85 \
  /var/run/nginx \
  /var/run/php-fpm \
  /var/run/rtorrent

